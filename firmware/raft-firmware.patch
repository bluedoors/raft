@@ -322,10 +323,17 @@ uint8_t goto_profile_without_updating_rgb_LED(uint8_t profile_number)
 
 void goto_profile(uint8_t profile_number)
 {
+  uint8_t prev_profile = current_profile_number;
   if(goto_profile_without_updating_rgb_LED(profile_number))
     return;
   load_persistent_state();
   neopixel_redraw_bg();
+  // Host LED overrides (PC status colours) survive a same-profile reload
+  // (e.g. wake-from-sleep) but are dropped when switching to another profile.
+  if(profile_number == prev_profile)
+    reapply_host_leds();
+  else
+    clear_host_leds();
 }
 
