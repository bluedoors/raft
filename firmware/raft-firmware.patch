diff --git a/firmware/evo/Src/neopixel.c b/firmware/evo/Src/neopixel.c
index 46d7770..7b9871f 100644
--- a/firmware/evo/Src/neopixel.c
+++ b/firmware/evo/Src/neopixel.c
@@ -258,6 +258,59 @@ void get_current_color(uint8_t which, uint8_t* red, uint8_t* green, uint8_t* blu
 void halt_all_animations(void)
 {
   for (size_t i = 0; i < NEOPIXEL_COUNT; i++)
-    neo_anime[i].animation_type = ANIMATION_NONE;  
+    neo_anime[i].animation_type = ANIMATION_NONE;
+}
+
+// ---- Host LED override layer (HID SET_LED_SINGLE) ----
+// A PC-set colour must survive (a) a keypress on that key and (b) a sleep/wake,
+// which reloads the profile and repaints every LED. We remember host colours
+// here, write them into the profile cache so keydown/keyup keep them, and
+// re-assert them after any same-profile repaint (see profiles.c goto_profile).
+static uint8_t host_led_active[NEOPIXEL_COUNT];
+static uint8_t host_led_rgb[NEOPIXEL_COUNT][THREE];
+
+static void apply_host_led(uint8_t which)
+{
+  // point default + keydown colours at the host colour so a keypress on this
+  // key fades back to it rather than the profile colour, then show it now.
+  for (uint8_t c = 0; c < THREE; c++)
+  {
+    curr_pf_info.sw_color_default[which][c] = host_led_rgb[which][c];
+    curr_pf_info.sw_color_keydown[which][c] = host_led_rgb[which][c];
+  }
+  set_pixel_3color_update_buffer(which, host_led_rgb[which][0],
+                                 host_led_rgb[which][1], host_led_rgb[which][2]);
+}
+
+void set_host_led(uint8_t which, uint8_t r, uint8_t g, uint8_t b)
+{
+  if(which >= NEOPIXEL_COUNT)
+    return;
+  host_led_active[which] = 1;
+  host_led_rgb[which][0] = r;
+  host_led_rgb[which][1] = g;
+  host_led_rgb[which][2] = b;
+  apply_host_led(which);
+  neopixel_draw_current_buffer();
+}
+
+void reapply_host_leds(void)
+{
+  uint8_t any = 0;
+  for (uint8_t i = 0; i < NEOPIXEL_COUNT; i++)
+  {
+    if(!host_led_active[i])
+      continue;
+    apply_host_led(i);
+    any = 1;
+  }
+  if(any)
+    neopixel_draw_current_buffer();
+}
+
+void clear_host_leds(void)
+{
+  for (uint8_t i = 0; i < NEOPIXEL_COUNT; i++)
+    host_led_active[i] = 0;
 }
 
